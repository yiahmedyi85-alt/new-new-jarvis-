# Generate long random values. Never commit real credentials.
JARVIS_CLOUD_TOKEN=replace-with-a-long-random-secret
JARVIS_BRIDGE_TOKEN=replace-with-a-different-long-random-secret
GEMINI_API_KEY=your-existing-gemini-key
GEMINI_MODEL=gemini-2.5-flash
JARVIS_DATA_DIR=./data
PUBLIC_BASE_URL=https://your-deployed-domain.example

# Optional outbound calls through a telephony provider.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
OWNER_PHONE_NUMBER=
